# Copy to .env and fill in for local dev. Never commit a populated .env.

# --- Runtime ---
PUTSCH_ENVIRONMENT=local
PUTSCH_SERVICE_NAME=putsch-ap-orchestrator

# --- Persistence ---
PUTSCH_DATABASE_URL=postgresql://putsch:putsch_dev_only@localhost:5432/putsch_orchestration
PUTSCH_CHECKPOINT_NAMESPACE=ap

# --- LLM proxy ---
PUTSCH_LITELLM_BASE_URL=http://localhost:4000
PUTSCH_LITELLM_API_KEY=sk-litellm-dev

# --- MCP endpoints ---
PUTSCH_SAP_MCP_URL=http://localhost:7001
PUTSCH_DATEV_MCP_URL=http://localhost:7002
PUTSCH_EMAIL_MCP_URL=http://localhost:7003
PUTSCH_MCP_TIMEOUT_SECONDS=30

# --- HITL thresholds (cents) ---
PUTSCH_AUTONOMOUS_POST_THRESHOLD_CENTS=1000000          # 10,000 EUR
PUTSCH_ABTEILUNGSLEITER_THRESHOLD_CENTS=5000000         # 50,000 EUR
PUTSCH_GESCHAEFTSFUEHRER_THRESHOLD_CENTS=25000000       # 250,000 EUR

# --- Retry / circuit breakers ---
PUTSCH_TOOL_RETRY_ATTEMPTS=4
PUTSCH_TOOL_RETRY_BASE_DELAY_SECONDS=0.5
PUTSCH_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
PUTSCH_CIRCUIT_BREAKER_RESET_SECONDS=60

# --- Observability ---
PUTSCH_OTEL_EXPORTER=stdout
# PUTSCH_OTEL_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces
PUTSCH_LOG_LEVEL=INFO

# --- GDPR / privacy ---
PUTSCH_LOG_INVOICE_CONTENT=false
PUTSCH_PII_REDACTION_PLACEHOLDER=[REDACTED]

# --- Model bindings (override only when swapping a model) ---
# PUTSCH_MODELS__REASONING=mistral/mistral-large-2
# PUTSCH_MODELS__GERMAN_EXTRACTION=huggingface/Qwen/Qwen2.5-72B-Instruct
# PUTSCH_MODELS__SAP_RFC_GENERATION=huggingface/Qwen/Qwen2.5-Coder-32B-Instruct
# PUTSCH_MODELS__GERMAN_PROSE=mistral/mistral-medium-3.5
